{
  "name": "mu",
  "displayName": "mu",
  "description": "Highlighting, formatting, hover, completion, go-to-definition, signature help and debugging for mu, a small language that transpiles to Python",
  "version": "0.2.0",
  "publisher": "shyal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shyal/mu.git",
    "directory": "vscode"
  },
  "homepage": "https://github.com/shyal/mu/tree/master/vscode",
  "bugs": {
    "url": "https://github.com/shyal/mu/issues"
  },
  "keywords": [
    "mu",
    "python",
    "transpiler",
    "leetcode",
    "debugger"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:mu",
    "onCommand:mu.debug",
    "onDebugResolve:mu",
    "onDebugDynamicConfigurations:mu"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mu",
        "aliases": [
          "mu"
        ],
        "extensions": [
          ".mu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mu",
        "scopeName": "source.mu",
        "path": "./syntaxes/mu.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "mu",
      "properties": {
        "mu.python": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter that runs the formatter (python -m mulang --fmt)."
        },
        "mu.debugScript": {
          "type": "string",
          "default": "mu/session.py",
          "description": "Script under the workspace root that `debug [file.mu]` writes the Python and its line map with (prints the Python file's path). The leet repo's is mu/session.py."
        },
        "mu.debugLogDir": {
          "type": "string",
          "default": "",
          "description": "When set, the mu debug adapter writes debugpy's logs to this folder (debugpy.adapter --log-dir)."
        }
      }
    },
    "configurationDefaults": {
      "[mu]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true
      }
    },
    "commands": [
      {
        "command": "mu.debug",
        "title": "Debug mu file",
        "category": "mu",
        "icon": "$(debug-alt)"
      }
    ],
    "keybindings": [
      {
        "command": "mu.debug",
        "key": "F5",
        "when": "editorLangId == mu"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "mu.debug",
          "when": "editorLangId == mu",
          "group": "navigation"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "mu"
      }
    ],
    "debuggers": [
      {
        "type": "mu",
        "label": "mu",
        "languages": [
          "mu"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "console": {
                "type": "string",
                "description": "Where the solve runs: internalConsole (default, the Debug Console), integratedTerminal or externalTerminal."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "mu",
            "request": "launch",
            "name": "mu: current.mu"
          }
        ],
        "configurationSnippets": [
          {
            "label": "mu: debug current.mu",
            "description": "Transpile current.mu and debug it, stepping through the mu file.",
            "body": {
              "type": "mu",
              "request": "launch",
              "name": "mu: current.mu"
            }
          }
        ]
      }
    ]
  },
  "extensionDependencies": [
    "ms-python.debugpy"
  ],
  "scripts": {
    "test": "node --test adapter.test.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}

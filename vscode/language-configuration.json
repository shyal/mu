{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["'", "'"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(def\\b.*|else\\s*|memo\\b(?:[^=]*|.*=)\\s*|(for|while|if|elif)\\b[^:]*|(sum|max|min|count)\\s+(from\\s+.+\\s+)?for\\b[^:]*)$",
    "decreaseIndentPattern": "^\\s*(elif|else)\\b"
  }
}
